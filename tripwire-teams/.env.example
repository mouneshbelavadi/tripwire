# Environment Configuration for Tripwire Teams

# Application Environment Mode ('development' | 'test' | 'production')
NODE_ENV=development

# HTTP Server Port
PORT=3000

# Slack Bolt App Credentials (Socket Mode)
# SLACK_BOT_TOKEN: Bot user OAuth token starting with xoxb-
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_APP_TOKEN: App-level token with connections:write scope starting with xapp-
SLACK_APP_TOKEN=xapp-your-slack-app-token
# SLACK_SIGNING_SECRET: Slack App Signing Secret for payload verification
SLACK_SIGNING_SECRET=your-slack-signing-secret

# PostgreSQL Database URL for Prisma ORM & pg-boss queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripwire_teams?schema=public

# AES-256-GCM Encryption Key (Must resolve to exactly 32 bytes)
# Supported formats: 64-character hex string, 44-character base64 string, or 32-character utf-8 string.
# Generate a secure key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google Maps Platform API Key (Routes API, Geocoding API)
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKey

# Google OAuth2 Credentials (for Google Calendar & Google Meet updates)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
